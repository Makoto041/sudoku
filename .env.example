# ランキングの保存先（Upstash Redis）。Vercel の Upstash 連携を使うと自動で入る
# 未設定のときは、ローカルではメモリに保存し、Vercel 上ではランキング API が 503 を返す
KV_REST_API_URL=
KV_REST_API_TOKEN=

# リマインド通知（Web Push）。鍵は `npx web-push generate-vapid-keys` で作る
# 1 つでも未設定なら、購読 API（/api/push）と cron（/api/cron/remind）は 503 を返す
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 連絡先。mailto: か https:// で始める
VAPID_SUBJECT=
# cron の認証。Vercel が Authorization: Bearer で付けて呼ぶ
CRON_SECRET=
