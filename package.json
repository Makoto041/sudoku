{
  "name": "sudoku",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:practice": "GEN_PRACTICE=1 vitest run src/lib/sudoku/practice-gen.test.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@upstash/redis": "1.39.0",
    "next": "16.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
